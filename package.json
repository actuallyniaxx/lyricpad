{
  "name": "lyricpad",
  "productName": "Lyricpad",
  "version": "1.2.1",
  "description": "A minimal lyrics editor for Windows with a side-by-side rhyme dictionary",
  "main": "main.js",
  "author": "actuallyniaxx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/actuallyniaxx/lyricpad.git"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win msi --x64 --publish never",
    "build:dir": "electron-builder --win dir --x64 --publish never",
    "test": "node test/prosody.test.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.actuallyniaxx.lyricpad",
    "productName": "Lyricpad",
    "copyright": "Copyright Ãƒâ€šÃ‚Â© 2026 actuallyniaxx",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "i18n.js",
      "renderer/**",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyricpad",
      "artifactName": "Lyricpad-${version}-win-x64.msi"
    }
  }
}
